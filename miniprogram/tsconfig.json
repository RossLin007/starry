{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["miniprogram/**/*", "typings/**/*"]
}
