@import "./styles/variables.wxss";

page {
  background-color: var(--starry-bg);
  color: var(--starry-text-main);
  font-family: "PingFang SC", "Noto Sans SC", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 0.02em;
}

view, text, image, navigator, input, button, textarea {
  box-sizing: border-box;
}

/* 全局主容器 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx;
}

/* 纸白基础卡片 (白昼世界) */
.starry-card {
  background-color: var(--starry-paper);
  border: 1rpx solid var(--starry-rice);
  border-radius: var(--starry-radius-md);
  box-shadow: var(--starry-shadow-sm);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

/* 星夜深色卡片 (星夜世界) */
.starry-card-night {
  background-color: var(--starry-night);
  border: 1rpx solid rgba(240, 217, 168, 0.2);
  border-radius: var(--starry-radius-lg);
  box-shadow: var(--starry-shadow-night);
  padding: 40rpx 32rpx;
  color: var(--starry-cream);
  margin-bottom: 24rpx;
}

/* 主操作按钮 (若星绿 · 唯一行动色) */
.starry-btn {
  background-color: var(--starry-green);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--starry-radius-full);
  padding: 20rpx 48rpx;
  text-align: center;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(1, 154, 74, 0.2);
  letter-spacing: 0.04em;
}

.starry-btn:active {
  opacity: 0.88;
}

/* 浅色辅助按钮 */
.starry-btn-secondary {
  background-color: var(--starry-bud);
  color: var(--starry-tea);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--starry-radius-full);
  padding: 16rpx 36rpx;
  text-align: center;
  border: none;
}

/* 签名三颗星分隔符 (✦ ✦ ✦) */
.star-divider {
  text-align: center;
  color: var(--starry-tea);
  font-size: 20rpx;
  letter-spacing: 24rpx;
  padding: 32rpx 0 32rpx 24rpx;
  opacity: 0.85;
}

/* 朱文印章 */
.star-seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--starry-crimson);
  border-radius: 10rpx;
  color: var(--starry-crimson);
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 22rpx;
  line-height: 1.1;
  opacity: 0.9;
  transform: rotate(-4deg);
}

/* 若星绿序号圆 */
.num-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--starry-green);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 标签：浅芽绿 */
.tag-bud {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--starry-radius-full);
  background-color: var(--starry-bud);
  color: var(--starry-tea);
  font-size: 22rpx;
  font-weight: 500;
}
