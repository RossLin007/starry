/* pages/growth/index.wxss */
/* 星夜世界专属样式 */

page {
  background-color: var(--starry-night);
  color: var(--starry-cream);
}

.growth-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
  background-color: var(--starry-night);
}

.star-hero-card {
  background: linear-gradient(150deg, #2A3859 0%, #1F2A44 60%, #172136 100%);
  border-radius: var(--starry-radius-lg);
  padding: 40rpx 32rpx;
  color: var(--starry-cream);
  box-shadow: var(--starry-shadow-night);
  border: 1rpx solid rgba(240, 217, 168, 0.3);
}

.hero-top {
  text-align: center;
  margin-bottom: 32rpx;
}

.user-tier-badge {
  font-size: 20rpx;
  background: rgba(240, 217, 168, 0.2);
  color: var(--starry-star);
  border: 1rpx solid rgba(240, 217, 168, 0.35);
  padding: 6rpx 20rpx;
  border-radius: var(--starry-radius-full);
  display: inline-block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(233, 228, 216, 0.7);
}

.points-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--starry-star);
  margin-top: 6rpx;
}

.points-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(233, 228, 216, 0.7);
}

.hero-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid rgba(240, 217, 168, 0.15);
  padding-top: 24rpx;
}

.stat-col {
  text-align: center;
}

.stat-val {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stat-u {
  font-size: 20rpx;
  font-weight: normal;
  color: rgba(233, 228, 216, 0.65);
}

.stat-lbl {
  font-size: 20rpx;
  color: rgba(233, 228, 216, 0.5);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(240, 217, 168, 0.15);
}

.heatmap-card {
  display: flex;
  flex-direction: column;
}

.card-title-night {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--starry-star);
  margin-bottom: 6rpx;
}

.card-subtitle-night {
  font-size: 22rpx;
  color: rgba(233, 228, 216, 0.6);
  margin-bottom: 24rpx;
}

.dots-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}

.dot-item {
  height: 100rpx;
  border-radius: var(--starry-radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dot-empty {
  background: rgba(61, 78, 115, 0.35);
  color: rgba(233, 228, 216, 0.4);
}

.dot-active {
  background: rgba(240, 217, 168, 0.18);
  border: 1rpx solid rgba(240, 217, 168, 0.4);
  color: var(--starry-star);
}

.dot-active .dot-star {
  color: var(--starry-star);
  font-size: 24rpx;
}

.dot-day {
  font-size: 20rpx;
  font-weight: 500;
}

.rules-card {
  font-size: 24rpx;
  color: rgba(233, 228, 216, 0.7);
  line-height: 1.8;
}

.rule-item {
  margin-top: 8rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}
