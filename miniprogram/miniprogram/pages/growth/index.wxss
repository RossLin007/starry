/* pages/growth/index.wxss */
.growth-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.star-hero-card {
  background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #312E81 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.15);
}

.hero-top {
  text-align: center;
  margin-bottom: 32rpx;
}

.user-tier-badge {
  font-size: 20rpx;
  background: rgba(251, 191, 36, 0.2);
  color: #FBBF24;
  border: 1rpx solid rgba(251, 191, 36, 0.3);
  padding: 6rpx 20rpx;
  border-radius: var(--starry-radius-full);
  display: inline-block;
  margin-bottom: 16rpx;
}

.points-label {
  font-size: 24rpx;
  color: #CBD5E1;
}

.points-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #FBBF24;
  margin-top: 6rpx;
}

.points-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #CBD5E1;
}

.hero-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  padding-top: 24rpx;
}

.stat-col {
  text-align: center;
}

.stat-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-u {
  font-size: 20rpx;
  font-weight: normal;
  color: #CBD5E1;
}

.stat-lbl {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.12);
}

.heatmap-card {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 6rpx;
}

.card-subtitle {
  font-size: 22rpx;
  color: var(--starry-text-muted);
  margin-bottom: 24rpx;
}

.dots-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}

.dot-item {
  height: 100rpx;
  border-radius: var(--starry-radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dot-empty {
  background: #F1F5F9;
  color: #94A3B8;
}

.dot-active {
  background: #EEF2FF;
  border: 1rpx solid #C7D2FE;
  color: var(--starry-primary);
}

.dot-active .dot-star {
  color: #F59E0B;
  font-size: 26rpx;
}

.dot-day {
  font-size: 20rpx;
  font-weight: 600;
}

.rules-card {
  font-size: 24rpx;
  color: var(--starry-text-secondary);
  line-height: 1.8;
}

.rule-item {
  margin-top: 8rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}
