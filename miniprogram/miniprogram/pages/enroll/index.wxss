/* pages/enroll/index.wxss */
.enroll-page {
  padding-bottom: 80rpx;
}

.course-summary {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #EEF2FF 0%, #FAF5FF 100%);
  border: 1rpx solid #E0E7FF;
}

.tag {
  font-size: 20rpx;
  color: var(--starry-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 12rpx;
}

.price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--starry-gold);
}

.form-card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--starry-muted-bg);
  padding-bottom: 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--starry-text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: var(--starry-radius-md);
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: var(--starry-radius-md);
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.submit-box {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
  padding: 26rpx 0;
  font-size: 30rpx;
}
