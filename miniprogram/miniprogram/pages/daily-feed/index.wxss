/* pages/daily-feed/index.wxss */
.daily-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.quote-card {
  background: linear-gradient(150deg, #2A3859 0%, #1F2A44 60%, #172136 100%);
  border-radius: var(--starry-radius-lg);
  padding: 48rpx 36rpx;
  color: var(--starry-cream);
  box-shadow: var(--starry-shadow-night);
  border: 1rpx solid rgba(240, 217, 168, 0.3);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.brand-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--starry-star);
}

.date-text {
  font-size: 22rpx;
  color: rgba(233, 228, 216, 0.65);
}

.quote-main {
  position: relative;
  margin-bottom: 40rpx;
}

.quote-text {
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1.8;
  color: var(--starry-cream);
  font-family: var(--starry-font-kaiti);
}

.quote-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.quote-author {
  font-size: 24rpx;
  color: rgba(233, 228, 216, 0.7);
}

.audio-bar {
  background: rgba(240, 217, 168, 0.12);
  backdrop-filter: blur(10px);
  border-radius: var(--starry-radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(240, 217, 168, 0.25);
}

.audio-icon {
  font-size: 40rpx;
}

.audio-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.audio-status {
  font-size: 20rpx;
  color: rgba(233, 228, 216, 0.65);
  margin-top: 4rpx;
}

.reflection-card {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--starry-ink);
  margin-bottom: 12rpx;
}

.reflection-body {
  font-size: 26rpx;
  color: var(--starry-tea);
  line-height: 1.8;
}

.save-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}
