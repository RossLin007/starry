/* pages/daily-feed/index.wxss */
.daily-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.quote-card {
  background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 60%, #312E81 100%);
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  color: #FFFFFF;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.18);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.brand-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FBBF24;
}

.date-text {
  font-size: 22rpx;
  color: #CBD5E1;
}

.quote-main {
  position: relative;
  margin-bottom: 40rpx;
}

.quote-mark {
  font-size: 80rpx;
  color: rgba(251, 191, 36, 0.2);
  line-height: 1;
  position: absolute;
  top: -30rpx;
  left: -10rpx;
}

.quote-text {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.7;
  color: #F8FAFC;
  font-family: serif;
}

.quote-author {
  text-align: right;
  font-size: 24rpx;
  color: #CBD5E1;
  margin-top: 24rpx;
}

.audio-bar {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border-radius: var(--starry-radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.audio-icon {
  font-size: 40rpx;
}

.audio-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.audio-status {
  font-size: 20rpx;
  color: #CBD5E1;
  margin-top: 4rpx;
}

.reflection-card {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 12rpx;
}

.reflection-body {
  font-size: 26rpx;
  color: var(--starry-text-secondary);
  line-height: 1.8;
}

.save-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}
