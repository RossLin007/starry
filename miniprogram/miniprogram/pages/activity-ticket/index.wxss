/* pages/activity-ticket/index.wxss */
.ticket-page {
  padding-top: 40rpx;
  padding-bottom: 80rpx;
}

.ticket-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 40rpx rgba(15, 23, 42, 0.08);
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
  margin-bottom: 40rpx;
}

.ticket-header {
  background: linear-gradient(135deg, #1E1B4B 0%, #312E81 100%);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-brand {
  font-size: 26rpx;
  font-weight: 700;
  color: #FBBF24;
}

.ticket-status-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--starry-radius-full);
  font-weight: 600;
}

.badge-pending {
  background: rgba(251, 191, 36, 0.2);
  color: #FBBF24;
  border: 1rpx solid rgba(251, 191, 36, 0.4);
}

.badge-checked {
  background: #D1FAE5;
  color: #065F46;
}

.ticket-main {
  padding: 36rpx 32rpx;
}

.ticket-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--starry-text-main);
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.ticket-detail-row {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.row-label {
  color: var(--starry-text-muted);
  width: 120rpx;
  flex-shrink: 0;
}

.row-val {
  color: var(--starry-text-secondary);
  font-weight: 500;
}

/* 虚线与凹槽 */
.ticket-divider {
  position: relative;
  height: 40rpx;
  display: flex;
  align-items: center;
}

.punch-hole {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
}

.left-hole {
  left: -20rpx;
}

.right-hole {
  right: -20rpx;
}

.dash-line {
  width: 100%;
  border-bottom: 2rpx dashed #CBD5E1;
  margin: 0 32rpx;
}

/* 二维码区域 */
.ticket-qr-section {
  padding: 32rpx;
  text-align: center;
  background: #FAFAFA;
}

.qr-box {
  width: 260rpx;
  height: 260rpx;
  margin: 0 auto 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--starry-primary);
}

.qr-mock-icon {
  font-size: 100rpx;
  line-height: 1;
}

.qr-mock-text {
  font-size: 18rpx;
  color: var(--starry-text-muted);
  margin-top: 10rpx;
}

.ticket-code-text {
  font-size: 28rpx;
  font-weight: 800;
  font-family: monospace;
  color: var(--starry-text-main);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.ticket-hint {
  font-size: 20rpx;
  color: var(--starry-text-muted);
}

.actions-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.home-btn {
  width: 100%;
  padding: 22rpx 0;
  background: #F1F5F9;
  color: var(--starry-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--starry-radius-full);
}
