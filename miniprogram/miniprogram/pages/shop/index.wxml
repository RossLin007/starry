<!-- pages/shop/index.wxml -->
<!-- 100% 严格对齐 docs/Design/prototype-v3/shop.html 原型规范 -->
<view class="screen">

  <view class="shop-intro">{{ shopIntro }}</view>

  <!-- 分类标签 -->
  <scroll-view class="cat-tabs" scroll-x enable-flex>
    <view
      wx:for="{{ categories }}"
      wx:key="*this"
      class="cat-tab-item {{ activeCategory === item ? 'active' : '' }}"
      data-cat="{{ item }}"
      bindtap="onSelectCategory"
    >
      {{ item }}
    </view>
  </scroll-view>

  <!-- 个性化伴手礼定制 (海报说明卡片，引导联系客服) -->
  <view wx:if="{{ activeCategory === '礼品订制' }}" class="gift-zone">
    <view class="card gift-card">
      <view class="gift-hero">
        <view class="gift-hero-title">个性化伴手礼定制</view>
        <view class="gift-hero-sub">一份带着心意的礼物</view>
      </view>
      <view class="gift-body">
        <view class="gift-desc">
          节日走访、感恩回馈、活动纪念……告诉我们你的场合与心意，若星为你搭配一份恰到好处的伴手礼。
        </view>
        <view class="gift-specs">
          <view class="spec-row">
            <text class="spec-label">定制内容</text>
            <text class="spec-val">素食茶点 · 谷物礼盒 · 茶饮组合</text>
          </view>
          <view class="spec-row">
            <text class="spec-label">定制方式</text>
            <text class="spec-val">告诉我们场合、预算与份数</text>
          </view>
          <view class="spec-row last-spec">
            <text class="spec-label">交付周期</text>
            <text class="spec-val">确认方案后 5-7 天</text>
          </view>
        </view>
        <view class="gift-action-box">
          <button class="gift-contact-btn" bindtap="onTapGiftContact">联系客服，聊聊你的想法</button>
          <view class="micro gift-hint">客服会与你一对一沟通定制方案</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品货架网格 (非礼品定制分类展示) -->
  <view wx:if="{{ activeCategory !== '礼品订制' }}" class="goods-grid">
    <view
      wx:for="{{ goods }}"
      wx:key="id"
      class="goods-card"
      data-item="{{ item }}"
      bindtap="onTapGoods"
    >
      <view class="goods-photo-box">
        <image class="goods-img" src="{{ item.coverUrl }}" mode="aspectFill" />
      </view>
      <view class="goods-body">
        <text class="mini-tag">第三方店铺</text>
        <view class="goods-name">{{ item.title }}</view>
        <view class="goods-desc" wx:if="{{ item.desc }}">{{ item.desc }}</view>
        <view class="goods-foot">
          <view class="goods-price">¥{{ item.price }} <text class="unit-sub">{{ item.unit || '' }}</text></view>
          <view class="goods-source">{{ item.sourceName || '若心拾光' }}</view>
        </view>
      </view>
    </view>
  </view>

</view>

<!-- 第三方小程序跳转对话框 -->
<view class="share-mask {{ showGoodsModal ? 'open' : '' }}" bindtap="onCloseGoodsModal">
  <view class="share-panel" catchtap="true">
    <view class="mini-panel-title">{{ selectedGoods ? selectedGoods.title : '' }}</view>
    <view class="mini-panel-sub">即将离开若星，前往第三方小程序购买。</view>
    <view class="mini-app-row">
      <view class="mini-app-ico">🛍️</view>
      <view>
        <view class="mini-app-name">{{ selectedGoods ? selectedGoods.sourceName : '若心拾光' }}</view>
        <view class="mini-app-meta">第三方小程序 · 由商家独立运营</view>
      </view>
    </view>
    <button class="mini-open" bindtap="onConfirmOpenMini">打开小程序</button>
    <button class="share-cancel" bindtap="onCloseGoodsModal">取消</button>
  </view>
</view>
