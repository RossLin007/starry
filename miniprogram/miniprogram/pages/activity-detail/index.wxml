<!-- pages/activity-detail/index.wxml -->
<view class="container detail-page" wx:if="{{ activity }}">
  <!-- 顶部封面与标签 -->
  <view class="banner-box">
    <image class="cover-img" src="{{ activity.coverUrl || 'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?w=600' }}" mode="aspectFill" />
    <view class="cover-tag">{{ activity.activityType === 'OFFLINE' ? '📍 线下雅集' : '💻 线上共创' }}</view>
  </view>

  <!-- 标题与状态卡片 -->
  <view class="starry-card info-card">
    <view class="price-row">
      <text class="price-main">{{ activity.price === 0 ? '免费参加' : '¥' + activity.price }}</text>
      <text class="quota-tip">限额 {{ activity.maxParticipants || '不限' }} 人 · 已报名 {{ activity.currentParticipants }} 人</text>
    </view>
    <view class="detail-title">{{ activity.title }}</view>
  </view>

  <!-- 时间与地点卡片 -->
  <view class="starry-card time-card">
    <view class="time-item">
      <text class="item-icon">🗓️</text>
      <view class="item-text">
        <view class="item-label">活动举办时间</view>
        <view class="item-val">{{ activity.startTime ? activity.startTime : '待定' }}</view>
      </view>
    </view>
    <view class="time-item">
      <text class="item-icon">📍</text>
      <view class="item-text">
        <view class="item-label">举办地点 / 接入方式</view>
        <view class="item-val">{{ activity.location || '线上腾讯会议' }}</view>
      </view>
    </view>
  </view>

  <!-- 活动内容介绍 -->
  <view class="starry-card content-card">
    <view class="section-title">活动详情与流程</view>
    <view class="content-body">
      {{ activity.content || '欢迎来到若星空间雅集。在这里，我们放慢步调，共同探讨生活秩序、器物美学与内省心念。' }}
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-left">
      <view class="bar-price">{{ activity.price === 0 ? '免费参加' : '¥' + activity.price }}</view>
      <view class="bar-tip">包含雅集茶饮与器物体验资料</view>
    </view>

    <view wx:if="{{ activity.isEnrolled }}" class="starry-btn ticket-btn" bindtap="onTapViewTicket">
      已报名 · 查看入场票 ➔
    </view>
    <view wx:else class="starry-btn enroll-btn" bindtap="onTapEnroll">
      立即报名
    </view>
  </view>
</view>
