/* pages/activity-detail/index.wxss */
.detail-page {
  padding-bottom: 160rpx;
}

.banner-box {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: var(--starry-radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(15, 23, 42, 0.75);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--starry-radius-full);
  backdrop-filter: blur(8px);
}

.info-card {
  margin-bottom: 24rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.price-main {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--starry-gold);
}

.quota-tip {
  font-size: 22rpx;
  color: #065F46;
  background: #D1FAE5;
  padding: 6rpx 18rpx;
  border-radius: var(--starry-radius-sm);
  font-weight: 600;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  line-height: 1.4;
}

.time-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.time-item {
  display: flex;
  align-items: center;
}

.item-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.item-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--starry-text-main);
}

.item-val {
  font-size: 22rpx;
  color: var(--starry-text-muted);
  margin-top: 4rpx;
}

.content-card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid var(--starry-muted-bg);
  padding-bottom: 12rpx;
}

.content-body {
  font-size: 26rpx;
  color: var(--starry-text-secondary);
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 130rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--starry-muted-bg);
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.bar-price {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--starry-gold);
}

.bar-tip {
  font-size: 20rpx;
  color: var(--starry-text-muted);
}

.enroll-btn {
  padding: 20rpx 48rpx;
}

.ticket-btn {
  padding: 20rpx 48rpx;
  background: #0F172A;
}
