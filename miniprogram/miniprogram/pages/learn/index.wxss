/* pages/learn/index.wxss */
.empty-box {
  padding: 100rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--starry-text-muted);
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.explore-btn {
  padding: 20rpx 60rpx;
}

.course-progress-card {
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #1E1B4B 0%, #312E81 100%);
  color: #FFFFFF;
}

.progress-tag {
  display: inline-block;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--starry-radius-sm);
  margin-bottom: 12rpx;
}

.progress-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.progress-bar-box {
  margin-bottom: 16rpx;
}

.bar-track {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--starry-radius-full);
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bar-fill {
  height: 100%;
  background: #FBBF24;
  border-radius: var(--starry-radius-full);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.shipping-notice {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  padding: 12rpx 20rpx;
  border-radius: var(--starry-radius-md);
  margin-top: 20rpx;
  font-size: 22rpx;
}

.notice-icon {
  margin-right: 12rpx;
}

.section-block {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.section-star {
  color: var(--starry-primary);
  font-size: 20rpx;
}

.section-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--starry-text-main);
}

.lessons-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lesson-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.lesson-card.locked {
  opacity: 0.6;
  background: #F8FAFC;
}

.lesson-info {
  flex: 1;
}

.lesson-order {
  font-size: 20rpx;
  color: var(--starry-text-muted);
  margin-bottom: 4rpx;
}

.lesson-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--starry-text-main);
}

.lesson-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--starry-radius-sm);
}

.badge-unlock {
  color: var(--starry-primary);
  background: var(--starry-primary-light);
}

.badge-lock {
  color: var(--starry-text-muted);
  background: #E2E8F0;
}

/* 课节弹窗 */
.lesson-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.lesson-modal-content {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-head {
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--starry-muted-bg);
  padding-bottom: 16rpx;
}

.modal-tag {
  font-size: 22rpx;
  color: var(--starry-primary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--starry-text-main);
}

.modal-body {
  max-height: 400rpx;
  margin-bottom: 32rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--starry-text-secondary);
  line-height: 1.6;
}

.modal-foot {
  padding-top: 16rpx;
}

.complete-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
}
