/* pages/checkin/index.wxss */
.checkin-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.tip-card {
  background: var(--starry-bud);
  border: 1rpx solid var(--starry-rice);
  color: var(--starry-ink);
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--starry-green);
  margin-bottom: 10rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--starry-tea);
  line-height: 1.6;
}

.tag-course {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--starry-tea);
  background: rgba(1, 154, 74, 0.1);
  padding: 6rpx 16rpx;
  border-radius: var(--starry-radius-sm);
  display: inline-block;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.content-input {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  color: var(--starry-ink);
  line-height: 1.7;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item, .upload-btn {
  width: 100%;
  height: 200rpx;
  border-radius: var(--starry-radius-md);
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-btn {
  background: var(--starry-muted-bg);
  border: 2rpx dashed var(--starry-rice);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.upload-text {
  font-size: 22rpx;
  color: var(--starry-ash);
}

.submit-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
  margin-top: 20rpx;
}
