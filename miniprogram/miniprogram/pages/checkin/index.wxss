/* pages/checkin/index.wxss */
.checkin-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.tip-card {
  background: linear-gradient(135deg, #1E1B4B 0%, #312E81 100%);
  color: #FFFFFF;
}

.tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FBBF24;
  margin-bottom: 10rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #E2E8F0;
  line-height: 1.5;
}

.tag-course {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #FBBF24;
  background: rgba(251, 191, 36, 0.15);
  padding: 6rpx 16rpx;
  border-radius: var(--starry-radius-sm);
  display: inline-block;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.content-input {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  color: var(--starry-text-main);
  line-height: 1.6;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item, .upload-btn {
  width: 100%;
  height: 200rpx;
  border-radius: var(--starry-radius-md);
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-btn {
  background: #F1F5F9;
  border: 2rpx dashed #CBD5E1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.upload-text {
  font-size: 22rpx;
  color: var(--starry-text-muted);
}

.submit-btn {
  width: 100%;
  padding: 24rpx 0;
  font-size: 28rpx;
  margin-top: 20rpx;
}
