/* pages/home/index.wxss */
/* 100% 严格复刻 docs/Design/prototype-v3/home.html 与 ruoxing.css */

.screen {
  min-height: 100vh;
  background-color: var(--starry-bg);
  padding: 24rpx 0 80rpx;
  color: var(--starry-ink);
  letter-spacing: 0.02em;
}

/* ---------- 1. 顶部引言区 ---------- */
.hero-section {
  padding-top: 24rpx;
  margin-bottom: 0;
}

.brand-lockup {
  display: inline-flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.bl-cn {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.32em;
  color: var(--starry-green);
}

.lede {
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 0.04em;
  color: var(--starry-green);
}

.meta {
  font-size: 26rpx;
  color: var(--starry-ash);
  line-height: 1.5;
}

.hero-meta {
  margin-top: 36rpx;
  max-width: 560rpx;
  line-height: 1.6;
}

.star-divider {
  text-align: center;
  color: var(--starry-tea);
  font-size: 18rpx;
  letter-spacing: 28rpx;
  padding: 36rpx 0 36rpx 28rpx;
  opacity: 0.85;
}

/* ---------- 2. 通用区块结构 ---------- */
.section {
  padding: 0 32rpx;
  margin-bottom: 56rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--starry-green);
}

.btn-text {
  font-size: 26rpx;
  color: var(--starry-green);
  letter-spacing: 0.04em;
  font-weight: 500;
}

/* 卡片容器 */
.card {
  background: var(--starry-paper);
  border: 1rpx solid var(--starry-rice);
  border-radius: var(--starry-radius-lg);
  overflow: hidden;
  box-shadow: var(--starry-shadow-sm);
}

/* ---------- 3. 我正在进行 ---------- */
.progress-card {
  padding: 8rpx 32rpx;
}

.inline-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
}

.inline-photo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.ir-text {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  font-size: 22rpx;
  color: var(--starry-tea);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}

.ir-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--starry-green);
  line-height: 1.4;
}

.ir-sub {
  font-size: 22rpx;
  color: var(--starry-ash);
  margin-top: 6rpx;
  line-height: 1.5;
}

.ir-action {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
}

.hairline {
  height: 1rpx;
  background: var(--starry-rice);
  width: 100%;
}

/* ---------- 4. 近期线上课程 ---------- */
.stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.course-card {
  display: block;
}

.photo-box {
  position: relative;
  aspect-ratio: 4 / 3;
  border-radius: 14rpx;
  margin: 20rpx 20rpx 0;
  overflow: hidden;
}

.course-photo {
  width: 100%;
  height: 100%;
}

.photo-label {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,.85);
  letter-spacing: 0.1em;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.3);
}

.card-body {
  padding: 24rpx 32rpx 32rpx;
}

.theme {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--starry-green);
  margin: 10rpx 0 12rpx;
  line-height: 1.5;
}

.meta-line {
  font-size: 24rpx;
  color: var(--starry-ash);
  line-height: 1.6;
}

.tag-box {
  margin-top: 18rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  letter-spacing: 0.05em;
  background: var(--starry-bud);
  color: var(--starry-tea);
}

.tag-green {
  background: rgba(1, 154, 74, 0.16);
  color: var(--starry-green);
  font-weight: 500;
}

.tag-disabled {
  background: var(--starry-rice);
  color: var(--starry-ash);
}

/* ---------- 5. 近期线下课程 ---------- */
.activity-card {
  padding: 8rpx 32rpx;
}

.activity-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx 0;
}

.photo-box-sm {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.act-photo {
  width: 100%;
  height: 100%;
}

.act-info {
  flex: 1;
}

.micro {
  font-size: 22rpx;
  color: var(--starry-ash);
}

.act-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--starry-green);
  margin: 4rpx 0 8rpx;
}

/* ---------- 6. 会员故事 ---------- */
.story-card {
  display: block;
}

.photo-box-story {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
}

.story-photo {
  width: 100%;
  height: 100%;
}

.story-body {
  padding: 28rpx 32rpx 32rpx;
}

.story-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--starry-green);
  margin-bottom: 14rpx;
}

.story-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--starry-ash);
}

.story-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid var(--starry-crimson);
  border-radius: 8rpx;
  color: var(--starry-crimson);
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 20rpx;
  line-height: 1.1;
  letter-spacing: 0;
  opacity: 0.9;
  transform: rotate(-4deg);
}

/* ---------- 7. 好物推荐网格 ---------- */
.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.goods-card {
  display: block;
  background: var(--starry-paper);
  border-radius: var(--starry-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--starry-rice);
  box-shadow: var(--starry-shadow-sm);
}

.goods-photo-box {
  position: relative;
  aspect-ratio: 1 / 1;
  width: 100%;
  overflow: hidden;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-body {
  padding: 20rpx 22rpx 24rpx;
}

.mini-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--starry-tea);
  border: 1rpx solid var(--starry-tea);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-bottom: 10rpx;
  letter-spacing: 0.05em;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--starry-green);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.goods-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goods-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--starry-green);
}

.unit-sub {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--starry-ash);
}

.goods-source {
  font-size: 20rpx;
  color: var(--starry-tea);
  letter-spacing: 0.04em;
}

/* ---------- 8. 会员入口 ---------- */
.member-section {
  text-align: center;
  padding-top: 16rpx;
  margin-bottom: 40rpx;
}

.member-title {
  margin-bottom: 32rpx;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 54rpx;
  border-radius: 44rpx;
  border: 2rpx solid var(--starry-green);
  color: var(--starry-green);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  background: transparent;
}

/* ---------- 9. 第三方小程序跳转面板 ---------- */
.share-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(28,36,20,.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity .25s ease-out, visibility .25s;
}

.share-mask.open {
  opacity: 1;
  visibility: visible;
}

.share-panel {
  width: 100%;
  background: #F7F3EA;
  border-radius: 36rpx 36rpx 0 0;
  padding: 44rpx 36rpx 60rpx;
  transform: translateY(40rpx);
  transition: transform .3s ease-out;
}

.share-mask.open .share-panel {
  transform: none;
}

.mini-panel-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--starry-ink);
  margin-bottom: 12rpx;
}

.mini-panel-sub {
  text-align: center;
  font-size: 24rpx;
  color: var(--starry-ash);
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.mini-app-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--starry-rice);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
}

.mini-app-ico {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--starry-green);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.mini-app-name {
  font-size: 28rpx;
  color: var(--starry-ink);
  font-weight: 500;
}

.mini-app-meta {
  font-size: 22rpx;
  color: var(--starry-ash);
  margin-top: 4rpx;
}

.mini-open {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  border: none;
  background: var(--starry-green);
  color: #FFFFFF;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}

.share-cancel {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  background: var(--starry-rice);
  border: none;
  color: var(--starry-ink);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
