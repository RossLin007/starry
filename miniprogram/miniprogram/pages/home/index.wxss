/* pages/home/index.wxss */
.hero-section {
  background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 100%);
  color: #FFFFFF;
  padding: 48rpx 36rpx;
  border-radius: var(--starry-radius-lg);
  margin-bottom: 32rpx;
  box-shadow: var(--starry-shadow-md);
}

.brand-badge {
  display: inline-block;
  font-size: 24rpx;
  color: var(--starry-gold);
  background: rgba(245, 158, 11, 0.15);
  padding: 6rpx 20rpx;
  border-radius: var(--starry-radius-full);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.slogan-group {
  margin-bottom: 20rpx;
}

.slogan-line {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.sub-slogan {
  font-size: 26rpx;
  color: #94A3B8;
  margin-top: 16rpx;
}

.quote-card {
  border-left: 8rpx solid var(--starry-primary);
}

.quote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quote-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--starry-text-main);
}

.quote-date {
  font-size: 22rpx;
  color: var(--starry-text-muted);
}

.quote-content {
  font-size: 26rpx;
  color: var(--starry-text-secondary);
  line-height: 1.6;
  font-style: italic;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--starry-text-main);
  margin: 32rpx 0 20rpx 8rpx;
}

.demo-card {
  position: relative;
}

.card-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--starry-primary);
  background: var(--starry-primary-light);
  padding: 4rpx 16rpx;
  border-radius: var(--starry-radius-sm);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.course-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--starry-text-main);
  margin-bottom: 8rpx;
}

.course-desc {
  font-size: 24rpx;
  color: var(--starry-text-secondary);
}
