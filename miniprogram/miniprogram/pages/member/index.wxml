<!-- pages/member/index.wxml -->
<view class="container member-page" wx:if="{{ benefits }}">
  <!-- 会员尊享 Hero 卡片 -->
  <view class="vip-hero-card">
    <view class="vip-badge">✦ STARRY VIP</view>
    <view class="vip-title">{{ benefits.tierName }}</view>
    <view class="vip-slogan">一年深度的空间整理与心念陪伴之旅</view>
    <view class="vip-price-box">
      <text class="currency">¥</text>
      <text class="price-val">{{ benefits.price }}</text>
      <text class="duration">/ 年 (365天)</text>
    </view>
  </view>

  <!-- 五大会员核心特权 -->
  <view class="starry-card benefits-card">
    <view class="section-title">✦ 星愿会员尊享 5 大特权</view>
    <view class="benefit-item" wx:for="{{ benefits.benefits }}" wx:key="title">
      <view class="b-icon-box">{{ item.icon }}</view>
      <view class="b-text">
        <view class="b-title">{{ item.title }}</view>
        <view class="b-desc">{{ item.desc }}</view>
      </view>
    </view>
  </view>

  <!-- 会员开通须知 -->
  <view class="starry-card note-card">
    <view class="section-title">开通与服务说明</view>
    <view class="note-item">1. 星愿会员有效期为自支付成功之日起 365 天。</view>
    <view class="note-item">2. 会员开通后，专属纸质礼盒将在 3 个工作日内寄出。</view>
    <view class="note-item">3. 报名若星空间全线整理营，系统将自动按 8.8 折特惠结算。</view>
  </view>

  <!-- 底部开通栏 -->
  <view class="bottom-action-bar">
    <view class="price-side">
      <view class="total-price">¥{{ benefits.price }}</view>
      <view class="price-hint">支持微信支付 · 即时生效</view>
    </view>
    <button class="starry-btn pay-btn" loading="{{ paying }}" bindtap="onTapPurchase">
      立即开通星愿会员 ➔
    </button>
  </view>
</view>
