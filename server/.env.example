NODE_ENV=development
PORT=3000

# 数据库连接
DATABASE_URL="postgresql://postgres:starry_secret_password@localhost:5432/starry_db?schema=public"

# JWT 鉴权
JWT_CLIENT_SECRET=starry_client_jwt_secret_dev_key_2026
JWT_CLIENT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=starry_admin_jwt_secret_dev_key_2026
JWT_ADMIN_EXPIRES_IN=1d

# 微信小程序
WECHAT_MINI_APP_ID=wx_dummy_appid
WECHAT_MINI_APP_SECRET=dummy_appsecret_32_chars

# 微信支付 V3
WECHAT_PAY_MCH_ID=1900000000
WECHAT_PAY_SERIAL_NO=YOUR_CERT_SERIAL_NO
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=dummy_api_v3_key_must_be_32chars
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/v1/payments/wechat/notify

# 存储
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:3000
